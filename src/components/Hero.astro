---

<div class="hero">
  <img src="/images/hero.webp" alt="hero" />
  <div class="text_hero">
    <p class="text">VELKOMMEN TIL <br /> MIT UNIVERS</p>
  </div>
</div>

<style>
  .hero {
    width: 100%;
    height: 85vh;
    object-fit: cover;
  }
  img {
    width: 100%;
    height: 85vh; /* viewportheight*/
    object-fit: cover;
  }
  .text_hero {
    position: absolute;
    top: 50%;
    left: 5%;
    font-size: 1.5rem;
    text-align: center;
    font-weight: 700;
  }

  .text {
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-weight: 400; /* Bold */
    font-style: normal;
  }
  @media (min-width: 768px) {
    .text_hero {
      position: absolute;
      top: 40%;
      left: 15%;
      font-size: 3rem;
      text-align: center;
      font-weight: 700;
    }
    .text_hero {
      font-size: 3rem;
    }
  }
</style>
