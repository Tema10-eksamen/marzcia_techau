---

---

<div class="hero">
  <img src="images/hero.webp" alt="hero" />
  <div class="text_hero">
    <p>VELKOMMEN TIL MIT UNIVERS</p>
  </div>
</div>
<div class="infosection">
  <div class="flex">
    <div>
      <img class="healingtdagen" src="illustrationer/htd.svg" alt="htd" />
      <p>HEALING TIL DAGEN</p>
    </div>
    <div>
      <img class="meditation" src="illustrationer/medi.svg" alt="meditation" />
      <p>MEDITATIONER</p>
    </div>
    <div>
      <img class="uddannelse" src="illustrationer/uddan.svg" alt="uddannelse" />
      <p>UDDANNELSER</p>
    </div>
    <div>
      <img class="bøger" src="illustrationer/bog.svg" alt="bøger" />
      <p>BØGER</p>
    </div>
  </div>
</div>

<style>
  .hero {
    width: 100%;
    height: 100vh;
    position: relative;
    object-fit: cover;
  }
  .text_hero {
    position: absolute;
    top: 50%;
    left: 15%;
    color: var(--color-primary);
  }

  /*info */
  .infosection {
    background-color: var(--color-secondary);
    color: var(--color-tertiary);
    position: absolute;
    width: 100%;
    top: 93%;
  }

  .flex {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr;
    gap: 10px;
  }

  .healingtdagen {
    width: 50%;
    height: auto;
    aspect-ratio: 377.81/343.45;
  }
  .meditation {
    width: 50%;
    height: auto;
    aspect-ratio: 465.26/512;
  }
  .uddannelse {
    width: 50%;
    height: auto;
    aspect-ratio: 512/294.88;
  }
  .bøger {
    width: 50%;
    height: auto;
    aspect-ratio: 512/372.2;
  }
</style>
