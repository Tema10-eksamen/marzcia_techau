<!-- med hjælp fra chat gpt  -->
<div class="carousel-wrapper margin">
  <!-- arrow fundet fra unicode - https://symbl.cc/en/collections/arrow-symbols/ -->
  <button class="arrow left">&#10094;</button>
  <div class="carousel" id="carousel">
    <div class="card">
      <a href="/produktliste">
        <img src="/images/healing.webp" alt="healing" />
        <h2>HEALINGSUDDANNELSE</h2>
      </a>
    </div>
    <div class="card">
      <a href="/">
        <img src="/images/clairvoyance.webp" alt="clairvoyance" />
        <h2>CLAIRVOYANCEUDANNELSE</h2>
      </a>
    </div>

    <div class="card">
      <a href="/">
        <img src="/images/workshop.webp" alt="workshop" />
        <h2>WORKSHOPS</h2>
      </a>
    </div>
  </div>
  <button class="arrow right">&#10095;</button>
</div>

<style>
  a {
    text-decoration: none;
  }
  .carousel-wrapper {
    position: relative;
  }

  .carousel {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 1rem;
    scroll-behavior: smooth;
  }

  .card {
    flex: 0 0 80%;
    scroll-snap-align: start;
    background: var(--color-quaternary);
    border-radius: 10px;
    padding: 1rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .card img {
    max-width: 100%;
    height: auto;
  }

  .arrow {
    display: none;
    position: absolute;
    top: 45%;
    transform: translateY(-50%);
    background-color: transparent;
    color: var(--color-secondary);
    border: none;
    font-size: 2rem;
    padding: 0.5rem;
    z-index: 10;
    cursor: pointer;
  }

  .arrow.left {
    left: 0.5rem;
  }

  .arrow.right {
    right: 0.5rem;
  }
  .arrow:hover {
    transition: 0.3s;
    color: var(--color-primary);
  }
  /* Karrusel kun mobil */
  @media (max-width: 767px) {
    .arrow {
      display: block;
    }
  }

  /* Desktop */
  @media (min-width: 768px) {
    .carousel {
      overflow-x: visible;
      flex-wrap: wrap;
      justify-content: space-between;
    }

    .card {
      flex: 0 0 30%;
    }
  }
</style>

<script>
  const carousel = document.getElementById("carousel");
  const leftBtn = document.querySelector(".arrow.left");
  const rightBtn = document.querySelector(".arrow.right");

  leftBtn.addEventListener("click", () => {
    carousel.scrollBy({ left: -carousel.clientWidth, behavior: "smooth" });
  });

  rightBtn.addEventListener("click", () => {
    carousel.scrollBy({ left: carousel.clientWidth, behavior: "smooth" });
  });
</script>
