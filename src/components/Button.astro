---
const { text } = Astro.props;
---

<button class="button">{text}</button>

<style>
  button {
    background-color: var(--color-action);
    color: var(--color-primary);
    border: none;
    padding: 0.6rem 1.4rem;
    border-radius: 5px;
    font-size: 1rem;
    cursor: pointer;
    transition: 0.3s ease;
  }

  button:hover {
    background-color: var(--color-hover);
  }
</style>
