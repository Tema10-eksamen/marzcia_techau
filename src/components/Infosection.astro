---

---

<div class="infosection">
  <div class="grid_4">
    <a href="/#">
      <div class="flex">
        <img class="healingtdagen" src="illustrationer/htd.svg" alt="htd" />
        <p>HEALING TIL DAGEN</p>
      </div>
    </a>
    <a href="/#">
      <div class="flex">
        <img class="meditation" src="illustrationer/medi.svg" alt="meditation" />
        <p>MEDITATIONER</p>
      </div>
    </a>
    <a href="/#">
      <div class="flex">
        <img class="uddannelse" src="illustrationer/uddan.svg" alt="uddannelse" />
        <p>UDDANNELSER</p>
      </div>
    </a>
    <a href="/#">
      <div class="flex">
        <img class="bøger" src="illustrationer/bog.svg" alt="bøger" />
        <p>BØGER</p>
      </div>
    </a>
  </div>

  <style>
    a {
      text-decoration: none;
      color: inherit;
    }
    a:hover {
      transform: scale(1.1);
      transition: 0.6s;
    }
    .infosection {
      background-color: var(--color-secondary);
      color: var(--color-tertiary);
    }
    .grid_4 {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr 1fr;
      object-fit: contain;
      align-content: baseline;
      align-items: center;
      justify-content: baseline;
    }

    .flex {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
    }

    .healingtdagen {
      width: 19%;
      height: auto;
      aspect-ratio: 377.81/343.45;
    }
    .meditation {
      width: 18%;
      height: auto;
      aspect-ratio: 465.26/512;
    }
    .uddannelse {
      width: 28%;
      height: auto;
      aspect-ratio: 512/294.88;
    }
    .bøger {
      width: 25%;
      height: auto;
      aspect-ratio: 512/372.2;
    }
  </style>
</div>
