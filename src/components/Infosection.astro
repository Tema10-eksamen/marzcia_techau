---

---

<div class="infosection">
  <div class="grid_4">
    <a href="/shop#healing">
      <div class="flex">
        <img class="healingtdagen" src="/illustrationer/htd.svg" alt="htd" />
        <p>HEALING TIL DAGEN</p>
      </div>
    </a>
    <a href="/shop#meditationer">
      <div class="flex">
        <img class="meditation" src="/illustrationer/medi.svg" alt="meditation" />
        <p>MEDITATIONER</p>
      </div>
    </a>
    <a href="/uddannelser">
      <div class="flex">
        <img class="uddannelse" src="/illustrationer/uddan.svg" alt="uddannelse" />
        <p>UDDANNELSER</p>
      </div>
    </a>
    <a href="/biografi#bog">
      <div class="flex">
        <img class="bøger" src="illustrationer/bog.svg" alt="bøger" />
        <p>BØGER</p>
      </div>
    </a>
  </div>

  <style>
    p {
      color: var(--color-quaternary);
      text-decoration: none;
    }
    a {
      text-decoration: none;
    }
    a:hover {
      transform: scale(1.1);
      transition: 0.6s;
    }
    .infosection {
      background-color: var(--color-secondary);
      padding: 5px;
    }

    .grid_4 {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 10px;
    }

    .flex {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
    }

    p {
      font-size: 0.8rem;
    }
    .healingtdagen {
      width: 70px;
      height: auto;
    }
    .meditation {
      width: 70px;
      height: auto;
    }
    .uddannelse {
      width: 90px;
      height: auto;
    }

    .bøger {
      width: 90px;
      height: auto;
    }
    @media (min-width: 768px) {
      p {
        font-size: 1.4rem;
      }
      .grid_4 {
        margin-left: 2rem;
        margin-right: 2rem;
        display: flex;
        align-items: baseline;
        justify-content: space-between;
      }
    }
  </style>
</div>
