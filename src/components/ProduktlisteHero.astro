---
import "../style/style.css";
---

<!-- Info-sektionen med titel og introduktion -->
<div class="info">
  <h1>Healingsuddannelser</h1>
  <p>
    Mine healingsuddannelser består af et grundforløb, med overbygningsforløb.
    <!-- Linjeskift kun på desktop -->
    <br class="desktop-br" />
    Du kan tage alle uddannelserne i dit eget tempo og tilpasset din hverdag.
  </p>
</div>

<!-- Sektion med to bokse (bullets) side om side på desktop -->
<div class="bullets">
  <!-- Box 1: Grundforløb -->
  <div class="box-1">
    <h2>Grundforløb:</h2>
    <ul>
      <li>Reiki 1 & 2 kurser - 4 undervisningsdage</li>
      <li>Spirituel healings kursus - 3 moduler af 2 dage</li>
      <li>Engle 1 & 2 kurser - 3 moduler af 2 dage</li>
    </ul>
    <p>Du skal minimum have 2 af de 3 healingsformer, før du kan tage overbygningskurserne.</p>
  </div>

  <!-- Box 2: Overbygningsforløb -->
  <div class="box-2">
    <h2>overbygningsforløb:</h2>
    <ul>
      <li>Karmisk-Epigenetisk healings kursus - 9 moduler af 2 dage</li>
      <li>Indre barn healings kursus - 6 moduler af 2 dage</li>
      <li>Healing af kræftramte - 2 moduler af 2 dage</li>
    </ul>
    <p>Reiki 3 uddannelsen - minium 121 timer og maksimum 250 timer</p>
  </div>
</div>

<style>
  /* --- Basis styling --- */

  /* Info-sektion margin for at adskille fra toppen */
  .info {
    margin-top: 2rem;
  }

  /* Baggrund og padding til bullets-sektionen */
  .bullets {
    background-color: var(--color-quaternary);
    margin-top: 2rem;
    margin-bottom: 3rem;
    padding-top: 1rem;
    padding-bottom: 1rem;
    border-radius: 5px;
  }

  /* Grundlæggende tekststyling for de vigtigste elementer */
  h1,
  h2,
  p,
  ul,
  li {
    margin-left: 1.5rem;
    margin-right: 1.5rem;
    color: var(--color-secondary);
    max-width: 40ch; /* Max bredde på tekst for bedre læsbarhed */
  }

  /* Justering af margin på listeelementer i bullets */
  .bullets ul {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
    font-family: var(--font-text);
  }

  .bullets li {
    margin-bottom: 0.5rem;
  }

  /* H2 overskrifter i bullets med uppercase og lidt afstand ovenover */
  .bullets h2 {
    text-transform: uppercase;
    margin-top: 1rem;
  }

  /* Afsnitsmargen for bedre luft */
  p {
    margin-bottom: 1.5rem;
    margin-top: 0.5rem;
  }

  /* Linjeskift som kun vises på desktop */
  .desktop-br {
    display: none;
  }

  /* --- Desktop styling fra 768px og op --- */
  @media (min-width: 768px) {
    /* Øger margin og max bredde på tekst for større skærme */
    h1,
    h2,
    p,
    ul,
    li {
      margin-left: 3rem;
      margin-right: 3rem;
      max-width: 65ch;
    }

    /* Mere bundmargen på info-sektionen */
    .info {
      margin-bottom: 3rem;
    }

    /* Bullets som grid med 2 kolonner, padding og gap */
    .bullets {
      display: grid;
      grid-template-columns: 1fr 1fr; /* To lige store kolonner */
      margin-bottom: 4rem;
      gap: 0.75rem; /* Lidt afstand mellem boksene */
      padding-left: 60px; /* Indvendig afstand til sider */
      padding-right: 60px;
      padding-top: 2rem;
      padding-bottom: 2rem;
    }

    /* Øget margin-top på paragrafer inde i boksene */
    .box-1 p,
    .box-2 p {
      margin-top: 2rem;
    }

    /* Mere luft mellem listeelementer */
    li {
      margin-top: 2rem;
      margin-bottom: 2rem;
    }

    /* Vis linjeskiftet på desktop */
    .desktop-br {
      display: inline;
    }
  }
</style>
