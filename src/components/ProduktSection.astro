---
const { data } = Astro.props;
---

<section class="info">
  <h1>Titel</h1>
  <div class="grid-1-1">
    <p>Beskrivelse</p>
  </div>
</section>
<section>
  <div class="grid_1-1">
    <div></div>
    <div>
      <h2>Uddannelsens rammer:</h2>
    </div>
  </div>
</section>

<style>
  button {
    background-color: var(--color-accent);
    border: none;
    color: var(--color-primary);
    cursor: pointer;
    border-radius: 6px;
    padding: 0.6rem 1.4rem;
    font-size: 1rem;
    transition: background-color 0.3s ease;
  }

  button:hover {
    background-color: #5e1f1f;
  }
</style>
