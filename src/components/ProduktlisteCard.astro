---
import "../style/style.css";
---

<div class="card-produktliste">
  <div class="card">
    <div class="cirkel-wrapper">
      <div class="cirkel"></div>

      <img class="illustration" src="illustrationer/reiki.svg" alt="Reiki" />
    </div>
    <div class="forløb">
      <p>01</p>
      <h2>REIKI</h2>
    </div>
    <div class="dato">
      <p>15.-16. november 2025</p>
    </div>
  </div>
  <button class="overlap-knap">Book</button>
</div>

<style>
  .card-produktliste {
    position: relative;
    width: 200px;
    padding-bottom: 1.5rem; /* plads til knappen udenfor kortet */
    background-color: var(--color-primary);
    border-radius: 5px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1); /* Giver kortet en lille skygge*/
  }

  .card {
    width: 100%;
    padding: 10px;
    background-color: var(--color-primary);
    border-radius: 5px;
    display: flex; /* Gør container til flexbox */
    flex-direction: column; /* elementer kommer i en lodret række */
    align-items: center; /* Center horisontalt */
    justify-content: center; /* Center lodret */
    justify-content: space-between;
  }

  .overlap-knap {
    width: 100px;
    position: absolute;
    bottom: -1rem; /* halvt udenfor */
    left: 50%;
    transform: translateX(-50%);
    background-color: var(--color-accent);
    border: none;
    color: var(--color-primary);
    cursor: pointer;
    border-radius: 5px;
    padding: 0.6rem 1.4rem;
    border-radius: 6px;
    font-size: 1rem;
    cursor: pointer;
    transition: 0.3s ease;
  }
  .overlap-knap:hover {
    background-color: #5e1f1f;
  }

  .card img {
    width: 20%;
    height: auto;
  }

  .cirkel-wrapper {
    position: relative;
    width: 100px;
    height: 100px;
  }

  .cirkel {
    width: 100%;
    height: 100%;
    background-color: var(--color-quaternary);
    border-radius: 50%;
  }
  .illustration {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .forløb {
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
    text-align: center;
  }

  /* Desktop */
  @media (min-width: 768px) {
    .card-produktliste {
      width: 230px;
      height: 280px;
    }
    .card img {
      width: 30%;
      height: auto;
    }
    .dato {
      margin-top: 1rem;
    }
  }
</style>
