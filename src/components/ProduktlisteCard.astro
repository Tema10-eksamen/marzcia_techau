---
import "../style/style.css";

// Modtag data som prop
const { data } = Astro.props;
---

<!-- Card-komponenten til et enkelt produkt/kursus -->
<div class="card-produktliste">
  <!-- Selve kortet med indhold -->
  <div class="card">
    <!-- Rund baggrund med illustration placeret centralt -->
    <div class="cirkel-wrapper">
      <div class="cirkel"></div>
      <!-- Baggrundscirkel -->

      <img class="illustration" src={data.image_url} alt={data.title} />
    </div>

    <!-- Tekstindhold: nummer og titel -->
    <div class="forløb">
      <p>0{data.number}</p>
      <h2>{data.title}</h2>
    </div>

    <!-- Dato for kurset -->
    <div class="dato">
      <p>{data.date_start} - {data.date_end}</p>
    </div>
  </div>

  <!-- Book-knap, som overlapper kortets bund -->
  <button class="overlap-knap">Book</button>
</div>

<style>
  /* --- Kortets overordnede container --- */
  .card-produktliste {
    position: relative; /* Så vi kan positionere knappen absolut ift. kortet */
    width: 200px; /* Fast bredde */
    padding-bottom: 1.5rem; /* Rum under kortet til knappen */
    background-color: var(--color-primary);
    border-radius: 5px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1); /* Blid skygge for dybde */
  }

  /* --- Selve kortets indhold --- */
  .card {
    width: 100%;
    padding: 10px;
    background-color: var(--color-primary);
    border-radius: 5px;
    display: flex;
    flex-direction: column; /* Elementerne stables lodret */
    align-items: center; /* Centrerer indhold horisontalt */
    justify-content: space-between; /* Skaber afstand mellem elementer lodret */
  }

  /* --- Knappen, som overlapper kortet --- */
  .overlap-knap {
    width: 100px;
    position: absolute; /* Absolut positionering ift. .card-produktliste */
    bottom: -1rem; /* Halvt udenfor kortets bund */
    left: 50%; /* Centrer horisontalt */
    transform: translateX(-50%); /* Justerer centreringsposition */
    background-color: var(--color-accent);
    border: none;
    color: var(--color-primary);
    cursor: pointer;
    border-radius: 6px;
    padding: 0.6rem 1.4rem;
    font-size: 1rem;
    transition: background-color 0.3s ease;
  }
  /* Hover-effekt for knappen */
  .overlap-knap:hover {
    background-color: #5e1f1f;
  }

  /* --- Illustration og cirkel --- */
  .card img {
    width: 20%; /* Billedets bredde i forhold til kortet */
    height: auto;
  }

  .cirkel-wrapper {
    position: relative; /* For at kunne placere billedet absolut */
    width: 100px;
    height: 100px;
  }

  .cirkel {
    width: 100%;
    height: 100%;
    background-color: var(--color-quaternary);
    border-radius: 50%; /* Rund cirkel */
  }

  .illustration {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%); /* Centrerer billedet i cirklen */
  }

  /* --- Tekstindhold under illustrationen --- */
  .forløb {
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
    text-align: center;
  }

  /* --- Responsivt design til desktop --- */
  @media (min-width: 768px) {
    .card-produktliste {
      width: 230px;
      height: 280px;
    }
    .card img {
      width: 30%; /* Større illustration på desktop */
      height: auto;
    }
    .dato {
      margin-top: 1rem; /* Lidt ekstra plads over dato */
    }
  }
</style>
