---
import "../style/style.css";
import CardProduktliste from "./CardProduktliste.astro";
---

<section>
  <div class="info">
    <h2>REIKI</h2>
    <p>Idéen bag Reiki-healing er, at alt i universet er energi, og at healeren kan fungere som en slags kanal for en universel livsenergi, som healeren overfører til sin klient. Jeg ser Reiki som en universel kærlighedsenergi af hvidt lys, der er til stede i hele verden og hele universet.</p>
    <p>Alle kan lære at heale med Reiki og der er ikke nogen religion forbundet til det.</p>
  </div>

  <h3>Mine kommende Reiki-uddannelser:</h3>

  <div class="slider">
    <button class="prev" aria-label="Forrige">←</button>

    <div class="card-wrapper">
      <div class="card-track">
        <div class="card-slide"><CardProduktliste /></div>
        <div class="card-slide"><CardProduktliste /></div>
        <div class="card-slide"><CardProduktliste /></div>
      </div>
    </div>

    <button class="next" aria-label="Næste">→</button>
  </div>
</section>

<style>
  section {
    background-color: var(--color-quaternary);
    padding-top: 2rem;
    padding-bottom: 3rem;
    border-radius: 5px;
    color: var(--color-secondary);
    font-family: var(--font-text);
  }
  .card-produktliste {
    display: flex;
    justify-content: center; /* Centrerer horisontalt */
    padding-top: 2rem;
    padding-bottom: 2rem;
  }
  .info {
    margin-bottom: 1rem;
    max-width: 40ch;
  }

  .info h2 {
    margin-bottom: 0.5rem;
  }

  .info p {
    margin-bottom: 1rem;
  }

  /* Hjælp fra chat gpt til at lave slider*/
  .slider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0rem;
    margin-top: 2rem;
  }

  .card-wrapper {
    width: 300px; /* samme som kortbredde */
    overflow: visible; /* gør plads til knappen */
    position: relative;
    display: flex;
    justify-content: center;
  }

  .card-track {
    display: flex;
    transition: transform 0.3s ease-in-out;
    width: calc(300px * 3); /* 3 kort, fast bredde */
  }

  .card-slide {
    position: relative; /* for at den indvendige knap kan positioneres relativt */
    flex-shrink: 0;
    display: flex;
    justify-content: center;
    width: 300px; /* samme bredde som wrapper */
  }

  button.prev,
  button.next {
    position: relative;
    z-index: 10;
    font-size: 2rem;
    background: none;
    border: none;
    color: var(--color-secondary);
    cursor: pointer;
    padding: 0;
    margin: 0;
    line-height: 1;
  }
</style>

<script>
  // Hjælp fra chat gpt til at lave slider
  let currentIndex = 0;

  function showCard(index) {
    const cards = document.querySelectorAll(".card-slide");
    const total = cards.length;

    if (index < 0) index = total - 1;
    if (index >= total) index = 0;

    currentIndex = index;

    const cardWidth = cards[0].clientWidth; // 300px
    const track = document.querySelector(".card-track");
    track.style.transform = `translateX(-${index * cardWidth}px)`; // Flyt med px, ikke %
  }

  window.addEventListener("DOMContentLoaded", () => {
    document.querySelector(".prev").addEventListener("click", () => showCard(currentIndex - 1));
    document.querySelector(".next").addEventListener("click", () => showCard(currentIndex + 1));
    showCard(0);
  });
</script>
