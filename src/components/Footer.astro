<style>
  footer {
    background-color: var(--color-secondary);
    color: var(--color-primary);
    padding: 20px;
  }

  p {
    color: var(--color-primary);
  }
  .grid_1_1 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .flex {
    display: flex;
    flex-direction: row;
    gap: 10px;
  }

  img {
    width: 9%;
    height: auto;
  }


  .contact_link {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: inherit;
    margin-bottom: 16px;
  }

  .contact_link img {
    width: 32px;
    height: 32px;
  }

  .ikoner {
    display: flex;
    gap: 12px;
    margin-top: 10px;
  }

  .ikoner a {
    text-decoration: none;
  }

  .ikoner img {
    width: 32px;
    height: 32px;
  }

  a {
  text-decoration: none;
  color: inherit;
  outline: none;
  border: none;
}

a img {
  border: none;
  outline: none;
}
  @media (min-width: 768px) {
    img {
      width: 50px;
      height: auto;
    }
    .flex {
      padding-top: 20px;
      display: flex;
      gap: 15px;
    }
    .grid_1_1 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
  }
</style>
