---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
---

<MainLayout>
  <Header />
  <h1 id="meditationer">Site under construction</h1>
  <div class="style" id="healing">
    <p>Da vi har afgrænset vores problemformulering til udelukkende at omhandle Marzcias uddannelsesforløb, har vi ikke fokuseret på og derfor ikke kodet denne side.</p>
  </div>
</MainLayout>

<style>
  .style {
    margin-top: 10rem;
    margin-bottom: 10rem;
    margin-left: 2rem;
    margin-right: 2rem;
  }
  p {
    margin-top: 3rem;
    margin-bottom: 22rem;
  }
  h1 {
    margin-left: 2rem;
    margin-right: 2rem;
    margin-top: 2rem;
  }
</style>
