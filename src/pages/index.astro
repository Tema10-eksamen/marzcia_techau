---
import MainLayout from "../layouts/MainLayout.astro";
import Header1 from "../components/Header1.astro";
import Hero from "../components/Hero.astro";
import Infosection from "../components/Infosection.astro";
import Karrusel from "../components/Karrusel.astro";
import AnmeldKarrusel from "../components/AnmeldKarrusel.astro";
import Faq from "../components/Faq.astro";
---

<MainLayout>
  <Header1 />
  <Hero />
  <Infosection />

  <section class="grid_1-1">
    <div>
      <h1>UDDANNELSER I HEALING & CLAIRVOYANCE</h1>
      <p>Jeg tilbyder uddannelser inden for både healing og clairvoyance – med mulighed for forskellige overbygninger, så du kan fordybe og udvikle dine evner i dit eget tempo. Derudover afholder jeg løbende workshops med fokus på praktiske øvelser, personlig udvikling og spirituel indsigt.</p>
      <br />
      <p>Jeg brænder for at undervise i healing og psykiske evner, fordi jeg tror på, at mennesker med stor sensitivitet og åbenhed har brug for redskaber til at forstå og bruge deres evner på en positiv og styrkende måde i hverdagen.</p>
      <br />
      <p>Klik nedenfor at læse mere om mine uddannelser og overbygninger.</p>
      <br />
    </div>

    <div class="align">
      <img src="/images/forside_ommig.webp" alt="portæt" />
    </div>
  </section>

  <Karrusel />

  <Faq />

  <AnmeldKarrusel />
</MainLayout>
<br />

<style>
  section {
    background-color: var(--color-quaternary);
    margin-top: 4rem;
    margin-bottom: 4rem;
    padding: 25px;
  }
  .align {
    display: flex;
    justify-content: center;
  }
  img {
    width: 100%;
    height: auto;
    border-radius: 3%;
  }

  @media (min-width: 768px) {
    .grid_1-1 {
      position: relative;
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    section {
      padding: 50px;
      margin-top: 7rem;
      margin-bottom: 7rem;
    }
    .align {
      position: absolute;
      top: -15%;
      left: 43%;
    }
    img {
      width: 40%;
      height: auto;
      border-radius: 3%;
      margin-top: 1rem;
    }
  }
</style>
